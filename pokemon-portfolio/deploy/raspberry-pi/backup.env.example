# Nightly database backup settings.  Lives at /etc/pokefolio/backup.env
# Test it any time with:  sudo systemctl start pokefolio-backup && journalctl -u pokefolio-backup -n 20

# Neon's DIRECT connection string (Neon → Connect → turn OFF "Connection pooling").
# Backups need the direct one; the pooled one ("-pooler" in the host name) can't run pg_dump.
BACKUP_DATABASE_URL=

# Where backups are written. The default is on the SD card; a USB stick mounted at
# /mnt/backup is better (see the guide), then set BACKUP_DIR=/mnt/backup/pokefolio
BACKUP_DIR=/var/backups/pokefolio

# How many days of backups to keep.
KEEP_DAYS=30

# Optional: an Uptime Kuma "Push" monitor URL. The backup pings it after every run, so you get
# an alert if a backup fails or stops running. Paste the whole URL Uptime Kuma shows.
BACKUP_PING_URL=
