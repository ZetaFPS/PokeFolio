# PokéFolio settings on the Raspberry Pi.  Lives at /etc/pokefolio/pokefolio.env
# Copy each value from Render → your service → Environment. Leave a line empty if you don't use it.
# After editing:  sudo systemctl restart pokefolio

# --- leave these as they are ---
NODE_ENV=production
PORT=3000
# The site is reached through Cloudflare Tunnel: trust its forwarded visitor address and https.
TRUST_PROXY=1

# --- required ---
# Neon → your project → Connect → copy the connection string (the same one Render uses).
DATABASE_URL=
# Your admin account's email (comma-separate several).
ADMIN_EMAILS=

# --- prices (optional) ---
PRICECHARTING_TOKEN=
POKEMONTCG_API_KEY=

# --- Premium / Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- two-factor sign-in / Twilio Verify (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
